// RLR · Mina — juego de minería infinito y compartido · mina.capitaltorreon.com — Ricardo López Reyero
// Probar en local: npx wrangler dev   ·   Publicar: npx wrangler deploy
{
  "name": "mina",
  "account_id": "93695b987a7460c681c06ca4df901ef4",
  "main": "src/mundo.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./publico",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "MUNDO", "class_name": "Mundo" }, { "name": "MAQUINA", "class_name": "Maquina" }, { "name": "TABLA", "class_name": "Tabla" }, { "name": "CUENTA", "class_name": "Cuenta" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mundo"] }, { "tag": "v2", "new_sqlite_classes": ["Maquina"] }, { "tag": "v3", "new_sqlite_classes": ["Tabla"] }, { "tag": "v4", "new_sqlite_classes": ["Cuenta"] }],
  // El botón de Google: el identificador de la app en Google Cloud (sus orígenes autorizados deben incluir https://mina.capitaltorreon.com).
  // La única llave de pago: STRIPE_SECRET_KEY vive UNA vez en la bóveda de la cuenta (Secrets Store «superleads») y aquí solo se liga.
  "secrets_store_secrets": [
    { "binding": "STRIPE_SECRET_KEY", "store_id": "308dac6355cb4d7a8bef6cc8ef7ee035", "secret_name": "STRIPE_SECRET_KEY" },
    // El correo de cumpleaños (gratitud) sale por Resend desde hola@capitaltorreon.com; la llave vive una vez en la bóveda.
    { "binding": "RESEND_API_KEY", "store_id": "308dac6355cb4d7a8bef6cc8ef7ee035", "secret_name": "RESEND_API_KEY" }
  ],
  // A las 3:33 pm, hora de Torreón (21:33 UTC; Coahuila no cambia de horario): el correo de cumpleaños a quien cumple hoy.
  "triggers": { "crons": ["33 21 * * *"] },
  // Las capturas de pantalla de la gente: una por archivo, en R2, por cuenta y por mundo (cap/<cuenta>/<mundo>/<id>.jpg)
  "r2_buckets": [{ "binding": "CAPTURAS", "bucket_name": "mina-capturas" }],
  "vars": { "GOOGLE_CLIENT_ID": "977641517971-23ouv33lu4s8ejrm6m4mgvuqcvpa9ucf.apps.googleusercontent.com" },
  "routes": [{ "pattern": "mina.capitaltorreon.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
